.superpowers/

_site/
/.quarto/
.venv/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store
**/*.quarto_ipynb

# Quarto's freeze-thaw staging output, written next to source .qmd files
# on a re-execution (not redirected by --output-dir). Kept narrowly scoped
# to the posts tree so it can never shadow the committed freeze cache
# directory at the repo root.
blog/posts/**/index_files/

# Series banner and prev/next navigation, regenerated from post front
# matter by scripts/sync_series.py on every render.
blog/posts/**/_series-*.md

# Ephemeral test fixture: created by the `site` pytest fixture before
# rendering (to exercise the `resources:` key on an unreferenced file) and
# deleted again afterwards. Never intended to be tracked or shipped.
notes/pdf/orphan-fixture.pdf
notes/thumbs/orphan-fixture.png

# Ephemeral test fixture: the maths-pipeline tests render this page and
# delete it again. Ignored so a crashed run cannot leave it to be committed.
/math-fixture.md
